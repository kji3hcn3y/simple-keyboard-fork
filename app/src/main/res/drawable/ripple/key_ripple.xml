<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
        <item android:state_active="true">
        <ripple xmlns:android="http://schemas.android.com/apk/res/android">
            <color android:name="@android:color/white" />
        </ripple>
    </item>
        <item android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_border" />
        <item android:state_active="true" android:state_pressed="true">
        <ripple xmlns:android="http://schemas.android.com/apk/res/android">
            <color android:alpha="192"
                   android:color="?attr/rippleColor" />
        </ripple>
    </item>
        <item
        android:drawable="@drawable/btn_keyboard_key_normal_border" />
</selector>
